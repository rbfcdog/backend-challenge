{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:integration": "bun --env-file=.env.example test ./test/financial.integration.test.ts --timeout 120000",
    "test:load": "bun --env-file=.env.example src/benchmark/load.ts",
    "test:load:matrix": "LOAD_CONCURRENCY=1 LOAD_REPORT=benchmarks/concurrency-1.json bun run test:load && LOAD_CONCURRENCY=24 LOAD_REPORT=benchmarks/baseline.json bun run test:load && LOAD_CONCURRENCY=48 LOAD_REPORT=benchmarks/concurrency-48.json bun run test:load",
    "db:migrate": "bun src/infrastructure/database/migrate.ts up",
    "db:rollback": "bun src/infrastructure/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1000.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
